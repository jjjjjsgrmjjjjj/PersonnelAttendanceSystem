[Unit]
Description=示例影像部 运动会考勤系统 (activity Sports Meeting Attendance)
Documentation=file:///opt/activity-kaoqin/README.md
After=network.target

[Service]
Type=simple
# 按实际部署路径修改
WorkingDirectory=/opt/activity-kaoqin
ExecStart=/usr/bin/node /opt/activity-kaoqin/src/server.js
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
# Environment=KAOQIN_DEFAULT_PASSWORD=换成你自己的初始密码
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=activity-kaoqin

# 若用非 root 用户运行（推荐），先创建用户：
#   useradd -r -s /usr/sbin/nologin activity
#   chown -R activity:activity /opt/activity-kaoqin
# User=activity
# Group=activity

# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/activity-kaoqin/data

[Install]
WantedBy=multi-user.target
